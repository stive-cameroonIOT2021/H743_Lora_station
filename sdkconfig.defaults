CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_STATION_LED_ENABLED=y
CONFIG_STATION_LED_GPIO=21
CONFIG_STATION_LED_BRIGHTNESS=8
CONFIG_STATION_TERMINAL_PRINT_DEFAULT=y
CONFIG_STATION_WEB_ENABLED=y
CONFIG_STATION_AP_SSID="VFPR-Station"
CONFIG_STATION_AP_PASSWORD="vfpr-ground"
CONFIG_STATION_AP_CHANNEL=1
CONFIG_STATION_AP_MAX_CLIENTS=3
CONFIG_MBEDTLS_AES_C=y
CONFIG_MBEDTLS_GCM_C=y
